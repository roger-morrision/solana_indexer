[Unit]
Description=Terminal DEX finalized external Solana exporter
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=sol
WorkingDirectory=/home/sol/solana-indexer
EnvironmentFile=/etc/solana-indexer-external.env
ExecStart=/usr/bin/env npm run export:external
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/sol/solana-indexer/inbox-mainnet /home/sol/solana-indexer/data

[Install]
WantedBy=multi-user.target
