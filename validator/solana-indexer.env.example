# Copy to /etc/solana-indexer.env, mode 0600, owned by root.
# Generate a high-entropy API key outside this repository; never commit it.
INDEXER_API_KEYS=replace-with-a-random-secret
INDEXER_HOST=127.0.0.1
INDEXER_PORT=8787
INDEXER_RATE_LIMIT_PER_MINUTE=600
INDEXER_AUDIT_LOG_FILE=/home/sol/solana-indexer/data/api-audit.jsonl
INDEXER_AUDIT_RETENTION_DAYS=30
# INDEXER_API_TENANTS_FILE=/etc/solana-indexer-tenants.json
INDEXER_STALE_AFTER_MS=120000
INDEXER_MAX_TRANSACTIONS=250000
# USD_DEPEG_REFERENCE_FILE=/home/sol/solana-indexer/data/usdc-usd-reference.json
# USDC_ORACLE_SOURCE_PROGRAM=reviewed-pyth-receiver-program
# USDC_ORACLE_SOURCE_ACCOUNT=reviewed-usdc-usd-price-update-account
# USDC_ORACLE_FEED_ID=reviewed-64-character-hex-feed-id
USDC_ORACLE_MAXIMUM_AGE_SECONDS=120
USDC_ORACLE_RELOAD_MS=5000
USDC_MAX_DEVIATION_BASIS_POINTS=200
INDEXER_INBOX=inbox
INDEXER_DATA_FILE=data/index.json
INDEXER_WAREHOUSE_CHECKPOINT_FILE=data/warehouse-checkpoint.json
INDEXER_WAREHOUSE_STALE_AFTER_MS=300000
INDEXER_MAX_WAREHOUSE_LAG_EVENTS=1000
EXPORTER_STATUS_FILE=data/exporter-status.json
# Warehouse clients inherit credentials without command-line secrets.
# PGPASSFILE=/etc/solana-indexer.pgpass
# PGHOST=127.0.0.1
# PGDATABASE=terminal_dex
# PGUSER=terminal_dex
# CLICKHOUSE_HOST=127.0.0.1
# CLICKHOUSE_USER=terminal_dex
# CLICKHOUSE_PASSWORD_FILE=/run/secrets/clickhouse_password
# REDIS_PASSWORD_FILE=/run/secrets/redis_password
INDEXER_REDIS_HOT_TTL_SECONDS=86400
INDEXER_REDIS_HOT_MAX_BYTES=16777216
INDEXER_DISTRIBUTED_QUOTA=false
INDEXER_REDIS_HOST=127.0.0.1
INDEXER_REDIS_PORT=6379
INDEXER_REDIS_QUOTA_TIMEOUT_MS=250
INDEXER_OPERATIONAL_JOB_LEASE_SECONDS=300
INDEXER_OPERATIONAL_JOB_MAX_ATTEMPTS=5
INDEXER_OPERATIONAL_JOB_BACKOFF_SECONDS=30
