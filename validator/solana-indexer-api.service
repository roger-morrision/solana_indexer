[Unit]
Description=Terminal DEX Solana indexer API and WebSocket service
After=network-online.target agave-validator.service solana-indexer-stream.service
Wants=network-online.target solana-indexer-stream.service

[Service]
Type=simple
User=sol
WorkingDirectory=/home/sol/solana-indexer
EnvironmentFile=/etc/solana-indexer.env
ExecStart=/usr/bin/env npm start
Restart=always
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/sol/solana-indexer/inbox /home/sol/solana-indexer/data

[Install]
WantedBy=multi-user.target
